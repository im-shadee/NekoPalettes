{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "679064c54e42497ca1957b5c8ffec9c2",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "FindPaletteUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1372.0,
            "y": -170.0,
            "width": 236.0,
            "height": 125.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a8dbd73c2282472db11dc50469c48621"
        },
        {
            "m_Id": "17e99ff04ca54d33a523d09e0482ab5f"
        },
        {
            "m_Id": "13e09f7e8f7c4e579a8ddd9f24da60b1"
        },
        {
            "m_Id": "cae9500bf0e04ba0bae8b4880b6aa3f4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FindPaletteUV",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "OutUV = float2(0.0, 0.5);\nfloat minDiff = 999.0;\n\nfor (int i = 0; i < (int)PaletteSize; i++)\n{\n    float u = (i + 0.5) / PaletteSize;\n    float4 paletteColor = SAMPLE_TEXTURE2D(BasePalette.tex, BasePalette.samplerstate, float2(u, 0.5));\n    float diff = distance(SpriteColor, paletteColor.rgb);\n    \n    if (diff < minDiff)\n    {\n        minDiff = diff;\n        OutUV = float2(u, 0.5);\n    }\n}"
}

